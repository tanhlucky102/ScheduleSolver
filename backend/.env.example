# ==============================================================================
# DATABASE CONFIGURATION (SUPABASE POSTGRESQL / SQLALCHEMY ORM)
# ==============================================================================
# Connection string PostgreSQL của Supabase.
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection String (URI).
#
# Cách 1: Transaction Pooler (Khuyên dùng cho API web / pooled connection, cổng 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Cách 2: Direct Connection / Session Pooler (Cổng 5432):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Lưu ý: Hệ thống sử dụng SQLAlchemy 2.0 ORM với driver psycopg (v3).
# Cả 2 dạng tiền tố postgresql:// và postgresql+psycopg:// đều được hỗ trợ tự động.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ==============================================================================
# SUPABASE API CREDENTIALS
# ==============================================================================
# Lấy tại Supabase Dashboard -> Project Settings -> API
# 1. Project URL:
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# 2. Publishable / Anon Key (Dùng để thẩm định JWT qua Supabase Auth endpoint /auth/v1/user):
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Service Role Secret Key (Khóa quản trị Supabase, chỉ lưu tại backend):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# APPLICATION & CORS SETTINGS
# ==============================================================================
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
